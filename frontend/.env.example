# Frontend-only CareGuide (no Spring Boot / Postgres).
# Copy to `.env` and restart `npm run dev`.
# The key is only read by the dev proxy (vite.config.ts) and the Vercel
# function (api/chat.ts); it is never bundled into the browser code.
# On Vercel, add OPENAI_API_KEY in Project Settings -> Environment Variables.

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_MODEL=gpt-4o-mini
